# Copy to .env and edit. .env is not committed.

# Optional VNC password (also needs the 5900 port uncommented)
VNC_PASSWORD=

# Owner of the files on the host: output of `id -u` and `id -g`
USER_ID=1000
GROUP_ID=1000
TZ=Europe/Rome

# Host folders
CONFIG_DIR=./config
STORAGE_DIR=/srv/media
WATCH_DIR=./watch
OUTPUT_DIR=./output

# Host ports
WEB_PORT=5800
VNC_PORT=5900

# Watch folder conversion. With an NVIDIA GPU you can use your own preset
# that picks an NVEnc encoder (create it in the GUI, then put its name here).
AUTOMATED_CONVERSION=1
AUTOMATED_CONVERSION_PRESET=General/Very Fast 1080p30
AUTOMATED_CONVERSION_FORMAT=mkv
AUTOMATED_CONVERSION_KEEP_SOURCE=1

# Which GPU(s): all, or an index/UUID from `nvidia-smi -L`
NVIDIA_VISIBLE_DEVICES=all

DARK_MODE=1
DISPLAY_WIDTH=1920
DISPLAY_HEIGHT=1080

# Production behind SWAG (see docker-compose.swag.yml and swag/):
# name of the docker network SWAG is attached to, and uncomment COMPOSE_FILE
# to always use the SWAG override.
SWAG_NETWORK=swag
#COMPOSE_FILE=docker-compose.yml:docker-compose.swag.yml
